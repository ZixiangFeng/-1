.page { height: 100vh; display: flex; flex-direction: column; }
.safe-top { padding-top: env(safe-area-inset-top); }
.safe-bottom { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.header { flex: none; margin: 0 28rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #dedfd6; display: flex; align-items: center; justify-content: space-between; }
.identity { display: flex; align-items: center; }
.orb, .brand-orb { display: flex; align-items: center; justify-content: center; background: #dce8cf; color: #315d50; border-radius: 50%; }
.orb { width: 82rpx; height: 82rpx; margin-right: 20rpx; }
.brand-orb { width: 120rpx; height: 120rpx; margin: 0 auto 28rpx; font-size: 42rpx; }
.name { font-size: 34rpx; font-weight: 600; }
.presence, .muted { color: #78827b; font-size: 24rpx; }
.messages { flex: 1; min-height: 0; padding: 22rpx 28rpx; box-sizing: border-box; }
.bottom-anchor { height: 20rpx; }
.empty { text-align: center; padding: 20vh 30rpx 0; }
.empty-title { font-size: 42rpx; font-family: serif; margin-bottom: 16rpx; }
.time { text-align: center; color: #919991; font-size: 22rpx; margin: 26rpx 0 10rpx; }
.row { display: flex; align-items: flex-start; margin: 24rpx 0; width: 100%; }
.row.user { justify-content: flex-end; }
.avatar { flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 600; box-shadow: 0 4rpx 12rpx rgba(38,60,52,.12); }
.avatar.bot { background: #dce8cf; color: #315d50; margin-right: 16rpx; }
.avatar.me { background: #2c6255; color: white; margin-left: 16rpx; }
.bubble-wrap { max-width: 76%; }
.bubble { padding: 22rpx 26rpx; border-radius: 28rpx; background: white; font-size: 31rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
.bubble.user { background: #e5ecd9; }
.message-image { display: block; width: 260rpx; height: 260rpx; border-radius: 22rpx; background: #e7e8e2; }
.typing { display: flex; align-items: center; min-width: 100rpx; min-height: 36rpx; }
.dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #849b8a; margin: 0 6rpx; animation: pulse 1.2s infinite; }
.d2 { animation-delay: .15s; }.d3 { animation-delay: .3s; }
@keyframes pulse { 0%,60%,100% { opacity:.35; transform:translateY(0) } 30% { opacity:1; transform:translateY(-6rpx) } }
.composer { flex: none; background: white; margin: 0 20rpx 14rpx; padding: 22rpx; border: 1rpx solid #e2e3da; border-radius: 30rpx; box-shadow: 0 12rpx 40rpx rgba(49,89,73,.07); }
.composer-input { width: 100%; min-height: 78rpx; max-height: 220rpx; font-size: 30rpx; box-sizing: border-box; }
.toolbar, .tool-left { display: flex; align-items: center; }
.toolbar { justify-content: space-between; gap: 12rpx; }
.tool-left { gap: 10rpx; }
button { margin: 0; }
.tool, .secondary, .plain { background: #edf0e7; color: #3d6053; font-size: 25rpx; border-radius: 18rpx; padding: 12rpx 18rpx; line-height: 1.4; }
.plain { background: transparent; padding: 8rpx; }
.emoji { font-size: 30rpx; }
.send, .primary { background: #2c6255; color: white; border-radius: 20rpx; font-size: 28rpx; padding: 15rpx 24rpx; line-height: 1.4; }
.selected-preview { position: relative; width: 140rpx; height: 140rpx; margin-bottom: 12rpx; }
.selected-preview image { width: 100%; height: 100%; border-radius: 18rpx; }
.remove { position: absolute; right: -13rpx; top: -13rpx; width: 42rpx; height: 42rpx; border-radius: 50%; padding: 0; line-height: 42rpx; background: #2c6255; color: white; }
.upload-cover { position: absolute; inset: 0; background: rgba(32,60,52,.48); border-radius: 18rpx; display:flex; align-items:center; justify-content:center; }
.spinner { width: 42rpx; height: 42rpx; border: 5rpx solid rgba(255,255,255,.35); border-top-color: white; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg) } }
.error { color: #a34730; font-size: 24rpx; margin-top: 18rpx; min-height: 34rpx; }
.inline-error { padding: 0 28rpx; margin: 0; }
.login-page { padding: 20vh 54rpx 40rpx; text-align: center; }
.login-title { font-size: 44rpx; font-weight: 600; margin-bottom: 12rpx; }
.wide { width: 100%; margin-top: 30rpx; }
.divider { color: #919991; font-size: 23rpx; margin: 34rpx 0 18rpx; }
.token-input { background: white; border: 1rpx solid #dedfd6; border-radius: 18rpx; padding: 22rpx; text-align: left; }
.modal-mask, .sheet-mask { position: fixed; inset: 0; background: rgba(22,61,50,.3); z-index: 20; display: flex; align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; }
.modal-card { background: white; width: 100%; max-width: 640rpx; border-radius: 32rpx; padding: 34rpx; box-sizing: border-box; }
.modal-title { font-size: 36rpx; font-weight: 600; }
.modal-copy { line-height: 1.8; margin-top: 20rpx; color: #52625d; }
.sheet-mask { align-items: flex-end; padding: 0; }
.sheet { background: white; width: 100%; max-height: 72vh; border-radius: 32rpx 32rpx 0 0; padding: 28rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-head { display: flex; justify-content: space-between; align-items: flex-start; font-size: 34rpx; font-weight: 600; }
.emoji-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 10rpx; margin-top: 24rpx; max-height: 54vh; overflow: auto; }
.emoji-choice { padding: 10rpx 0; background: #f2f3ee; color: #283c38; font-size: 40rpx; line-height: 1.3; border-radius: 14rpx; }
.library-sheet { height: 76vh; display: flex; flex-direction: column; }
.small { font-size: 21rpx; font-weight: 400; margin-top: 5rpx; }
.import-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.import-actions button { flex: 1; }
.library-progress { min-height: 36rpx; color: #78827b; font-size: 22rpx; padding-top: 12rpx; }
.library-scroll { flex: 1; min-height: 0; }
.library-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; padding-bottom: 30rpx; }
.library-item { aspect-ratio: 1; padding: 5rpx; background: #edf0e7; border-radius: 18rpx; }
.library-item image { width: 100%; height: 100%; border-radius: 14rpx; }
.library-empty { text-align: center; color: #78827b; padding-top: 100rpx; }
.picker { background: #edf0e7; padding: 18rpx; border-radius: 16rpx; margin: 24rpx 0; }
.survey-item { margin: 24rpx 0; font-size: 27rpx; }
