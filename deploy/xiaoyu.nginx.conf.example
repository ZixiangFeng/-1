# Include in the local HTTPS virtual host. Declare the xiaoyu_enroll limit_req_zone in the http block.
location = /xiaoyu { return 302 https://$host/xiaoyu/; }
location /xiaoyu/ {
    if ($scheme = http) { return 302 https://$host$request_uri; }
    client_max_body_size 9m;
    proxy_pass http://127.0.0.1:8765/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
}

location = /xiaoyu/api/demo/enroll {
    if ($scheme = http) { return 302 https://$host$request_uri; }
    limit_req zone=xiaoyu_enroll burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 1k;
    proxy_pass http://127.0.0.1:8765/api/demo/enroll;
    proxy_set_header Host $host;
}
